# Normalise to LF in the repository. Without this, a Windows checkout commits
# gradlew with CRLF and every Linux/macOS clone fails with "bad interpreter".
* text=auto eol=lf

gradlew        text eol=lf
*.sh           text eol=lf
*.kt           text eol=lf
*.kts          text eol=lf
*.java         text eol=lf
*.xml          text eol=lf
*.md           text eol=lf
*.toml         text eol=lf
*.pro          text eol=lf
*.properties   text eol=lf

# Windows batch files genuinely need CRLF
*.bat          text eol=crlf

*.jar     binary
*.apk     binary
*.aab     binary
*.png     binary
*.jpg     binary
*.webp    binary
*.keystore binary
*.jks     binary
