<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" already stops cloud backup, but device-to-device transfer
  on Android 12+ is governed separately. Nothing here is worth moving to another
  phone, and the MR slot is the kind of thing that should stay put, so both
  channels are emptied explicitly rather than left to the default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
